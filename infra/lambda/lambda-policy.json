{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowLambdaToWriteLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowLambdaToAccessS3Buckets",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::landing-images/*",
                "arn:aws:s3:::thumbnails/*"
            ]
        },
        {
            "Sid": "AllowLambdaToAccessDynamoDB",
            "Effect": "Allow",
            "Action": [
                "dynamodb:PutItem",
                "dynamodb:GetItem",
                "dynamodb:UpdateItem"
            ],
            "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/*"
        }
    ]
}